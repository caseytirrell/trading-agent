# Server-side only. Never prefix these with NEXT_PUBLIC_.
# ALPACA_ENDPOINT must be the paper endpoint — live trading is blocked.
ALPACA_ENDPOINT=https://paper-api.alpaca.markets
ALPACA_API_KEY=your_paper_key_here
ALPACA_SECRET_KEY=your_paper_secret_here
OPENAI_API_KEY=your_openai_key_here

# Fail-closed kill switch: trading is blocked unless this is explicitly true.
# Keep false for normal development, testing, and analysis-only use.
TRADING_ENABLED=false

# Neon Postgres (server-side persistence, Phase 2). Never NEXT_PUBLIC_.
# DATABASE_URL is the POOLED Neon connection string (runtime queries).
# DIRECT_URL is the DIRECT connection string (Prisma introspection/diff only).
# The schema is managed manually in Neon — never run prisma migrate/db push.
DATABASE_URL=postgresql://user:password@your-project-pooler.region.aws.neon.tech/trading-agent-paper?sslmode=require
DIRECT_URL=postgresql://user:password@your-project.region.aws.neon.tech/trading-agent-paper?sslmode=require
